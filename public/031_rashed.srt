1
00:00:00,016 --> 00:00:07,950
الٓمٓۚ

2
00:00:08,333 --> 00:00:11,833
تِلۡكَ ءَايَٰتُ اُ۬لۡكِتَٰبِ اِ۬لۡحَكِيمِ 

3
00:00:12,350 --> 00:00:15,716
هُدٗى وَرَحۡمَةٗ لِّلۡمُحۡسِنِينَ 

4
00:00:16,116 --> 00:00:25,550
اَ۬لَّذِينَ يُقِيمُونَ اَ۬لصَّلَوٰةَ وَيُوتُونَ اَ۬لزَّكَوٰةَ وَهُم بِالۡأٓخِرَةِ هُمۡ يُوقِنُونَ 

5
00:00:25,783 --> 00:00:37,416
أُوْلَٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ وَأُوْلَٰٓئِكَ هُمُ اُ۬لۡمُفۡلِحُونَ 

6
00:00:37,933 --> 00:00:56,883
وَمِنَ اَ۬لنَّاسِ مَن يَشۡتَرِي لَهۡوَ اَ۬لۡحَدِيثِ لِيَضِلَّ عَن سَبِيلِ اِ۬للَّهِ بِغَيۡرِ عِلۡمٖ وَيَتَّخِذُهَا هُزُؤًاۚ أُوْلَٰٓئِكَ لَهُمۡ عَذَابٞ مُّهِينٞ 

7
00:00:57,183 --> 00:01:14,733
وَإِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا وَلَّىٰ مُسۡتَكۡبِرٗا كَأَن لَّمۡ يَسۡمَعۡهَا كَأَنَّ فِي أُذُنَيۡهِ وَقۡرٗاۖ فَبَشِّرۡهُ بِعَذَابٍ أَلِيمٍ 

8
00:01:15,233 --> 00:01:24,533
إِنَّ اَ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتُ اُ۬لنَّعِيمِ 

9
00:01:24,833 --> 00:01:32,666
خَٰلِدِينَ فِيهَاۖ وَعۡدَ اَ۬للَّهِ حَقّٗاۚ وَهۡوَ اَ۬لۡعَزِيزُ اُ۬لۡحَكِيمُ 

10
00:01:33,033 --> 00:02:06,266
۞خَلَقَ اَ۬لسَّمَٰوَٰتِ بِغَيۡرِ عَمَدٖ تَرَوۡنَهَاۖ وَأَلۡقَىٰ فِي اِ۬لۡأَرۡضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمۡ وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖۚ وَأَنزَلۡنَا مِنَ اَ۬لسَّمَآءِ مَآءٗ فَأَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ

11
00:02:06,700 --> 00:02:19,050
هَٰذَا خَلۡقُ اُ۬للَّهِ فَأَرُونِي مَاذَا خَلَقَ اَ۬لَّذِينَ مِن دُونِهِۦۚ بَلِ اِ۬لظَّٰلِمُونَ فِي ضَلَٰلٖ مُّبِينٖ

12
00:02:19,383 --> 00:02:38,033
۞وَلَقَدۡ ءَاتَيۡنَا لُقۡمَٰنَ اَ۬لۡحِكۡمَةَ أَنِ اِ۟شۡكُر لِّلَّهِۚ وَمَن يَشۡكُرۡ فَإِنَّمَا يَشۡكُر لِّنَفۡسِهِۦۖ وَمَن كَفَرَ فَإِنَّ اَ۬للَّهَ غَنِيٌّ حَمِيدٞ

13
00:02:38,333 --> 00:02:51,350
وَإِذۡ قَال لُّقۡمَٰنُ لِاِبۡنِهِۦ وَهۡوَ يَعِظُهُۥ يَٰبُنَيِّ لَا تُشۡرِكۡ بِاللَّهِۖ إِنَّ اَ۬لشِّرۡكَ لَظُلۡمٌ عَظِيمٞ

14
00:02:51,666 --> 00:03:08,166
وَوَصَّيۡنَا اَ۬لۡإِنسَٰنَ بِوَٰلِدَيۡهِ حَمَلَتۡهُ أُمُّهُۥ وَهۡنًا عَلَىٰ وَهۡنٖ وَفِصَٰلُهُۥ فِي عَامَيۡنِ أَنِ اِ۟شۡكُر لِّي وَلِوَٰلِدَيۡكَ إِلَيَّ اَ۬لۡمَصِيرُ

15
00:03:08,466 --> 00:03:38,866
وَإِن جَٰهَدَاكَ عَلَىٰ أَن تُشۡرِكَ بِي مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٞ فَلَا تُطِعۡهُمَاۖ وَصَاحِبۡهُمَا فِي اِ۬لدُّنۡيۭا مَعۡرُوفٗاۖ وَاَتَّبِعۡ سَبِيلَ مَنۡ أَنَابَ إِلَيَّۚ ثُمَّ إِلَيَّ مَرۡجِعُكُمۡ فَأُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ

16
00:03:39,166 --> 00:04:03,350
يَٰبُنَيِّ إِنَّهَا إِن تَكُ مِثۡقَالَ حَبَّةٖ مِّنۡ خَرۡدَلٖ فَتَكُن فِي صَخۡرَةٍ أَوۡ فِي اِ۬لسَّمَٰوَٰتِ أَوۡ فِي اِ۬لۡأَرۡضِ يَاتِ بِهَا اَ۬للَّهُۚ إِنَّ اَ۬للَّهَ لَطِيفٌ خَبِيرٞ

17
00:04:03,750 --> 00:04:20,450
يَٰبُنَيِّ أَقِمِ اِ۬لصَّلَوٰةَ وَامُرۡ بِالۡمَعۡرُوفِ وَاَنۡهَ عَنِ اِ۬لۡمُنكَرِ وَاَصۡبِرۡ عَلَىٰ مَا أَصَابَكَۖ إِنَّ ذَٰلِكَ مِنۡ عَزۡمِ اِ۬لۡأُمُورِ

18
00:04:20,816 --> 00:04:36,283
وَلَا تُصَٰعِرۡ خَدَّكَ لِلنَّاسِ وَلَا تَمۡشِ فِي اِ۬لۡأَرۡضِ مَرَحًاۖ إِنَّ اَ۬للَّهَ لَا يُحِبُّ كُلَّ مُخۡتَالٖ فَخُورٖ

19
00:04:36,566 --> 00:04:48,350
وَاَقۡصِدۡ فِي مَشۡيِكَ وَاَغۡضُضۡ مِن صَوۡتِكَۚ إِنَّ أَنكَرَ اَ۬لۡأَصۡوَٰتِ لَصَوۡتُ اُ۬لۡحَمِيرِ

20
00:04:48,750 --> 00:05:14,366
أَلَمۡ تَرَوۡاْ أَنَّ اَ۬للَّهَ سَخَّر لَّكُم مَّا فِي اِ۬لسَّمَٰوَٰتِ وَمَا فِي اِ۬لۡأَرۡضِ وَأَسۡبَغَ عَلَيۡكُمۡ نِعَمَهُۥ ظَٰهِرَةٗ وَبَاطِنَةٗۗ وَمِنَ اَ۬لنَّاسِ مَن يُجَٰدِلُ فِي اِ۬للَّهِ بِغَيۡرِ عِلۡمٖ وَلَا هُدٗى وَلَا كِتَٰبٖ مُّنِيرٖ

21
00:05:14,716 --> 00:05:37,000
وَإِذَا قِيل لَّهُمُ اُ۪تَّبِعُواْ مَا أَنزَلَ اَ۬للَّهُ قَالُواْ بَلۡ نَتَّبِعُ مَا وَجَدۡنَا عَلَيۡهِ ءَابَآءَنَاۚ أَوَلَوۡ كَانَ اَ۬لشَّيۡطَٰنُ يَدۡعُوهُمۡ إِلَىٰ عَذَابِ اِ۬لسَّعِيرِ

22
00:05:37,333 --> 00:05:53,866
۞وَمَن يُسۡلِمۡ وَجۡهَهُۥ إِلَى اَ۬للَّهِ وَهۡوَ مُحۡسِنٞ فَقَدِ اِ۪سۡتَمۡسَكَ بِالۡعُرۡوَةِ اِ۬لۡوُثۡقۭيٰۗ وَإِلَى اَ۬للَّهِ عَٰقِبَةُ اُ۬لۡأُمُورِ

23
00:05:54,383 --> 00:06:12,900
وَمَن كَفَرَ فَلَا يَحۡزُنكَ كُفۡرُهُۥۚ إِلَيۡنَا مَرۡجِعُهُمۡ فَنُنَبِّئُهُم بِمَا عَمِلُواْۚ إِنَّ اَ۬للَّهَ عَلِيمُۢ بِذَاتِ اِ۬لصُّدُورِ

24
00:06:13,333 --> 00:06:23,316
نُمَتِّعُهُمۡ قَلِيلٗا ثُمَّ نَضۡطَرُّهُمۡ إِلَىٰ عَذَابٍ غَلِيظٖ

25
00:06:23,616 --> 00:06:42,216
وَلَئِن سَأَلۡتَهُم مَّنۡ خَلَقَ اَ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضَ لَيَقُولُنَّ اَ۬للَّهُۚ قُلِ اِ۬لۡحَمۡدُ لِلَّهِۚ بَلۡ أَكۡثَرُهُمۡ لَا يَعۡلَمُونَ

26
00:06:42,533 --> 00:06:52,300
لِلَّهِ مَا فِي اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۚ إِنَّ اَ۬للَّه هُّوَ اَ۬لۡغَنِيُّ اُ۬لۡحَمِيدُ

27
00:06:52,583 --> 00:07:15,116
وَلَوۡ أَنَّمَا فِي اِ۬لۡأَرۡضِ مِن شَجَرَةٍ أَقۡلَٰمٞ وَاَلۡبَحۡرَ يَمُدُّهُۥ مِنۢ بَعۡدِهِۦ سَبۡعَةُ أَبۡحُرٖ مَّا نَفِدَتۡ كَلِمَٰتُ اُ۬للَّهِۚ إِنَّ اَ۬للَّهَ عَزِيزٌ حَكِيمٞ

28
00:07:15,583 --> 00:07:28,000
مَّا خَلۡقُكُمۡ وَلَا بَعۡثُكُمۡ إِلَّا كَنَفۡسٖ وَٰحِدَةٍۚ إِنَّ اَ۬للَّهَ سَمِيعُۢ بَصِيرٌ

29
00:07:28,266 --> 00:08:01,983
أَلَمۡ تَرَ أَنَّ اَ۬للَّهَ يُولِجُ اُ۬لَّيۡلَ فِي اِ۬لنَّه۪ارِ وَيُولِجُ اُ۬لنَّهَارَ فِي اِ۬لَّيۡلِ وَسَخَّرَ اَ۬لشَّمۡسَ وَاَلۡقَمَرَۖ كُلّٞ يَجۡرِي إِلَىٰ أَجَلٖ مُّسَمّٗى وَأَنَّ اَ۬للَّهَ بِمَا تَعۡمَلُونَ خَبِيرٞ

30
00:08:02,400 --> 00:08:16,150
ذَٰلِكَ بِأَنَّ اَ۬للَّه هُّوَ اَ۬لۡحَقُّ وَأَنَّ مَا يَدۡعُونَ مِن دُونِهِ اِ۬لۡبَٰطِلُ وَأَنَّ اَ۬للَّه هُّوَ اَ۬لۡعَلِيُّ اُ۬لۡكَبِيرُ

31
00:08:16,483 --> 00:08:33,850
أَلَمۡ تَرَ أَنَّ اَ۬لۡفُلۡكَ تَجۡرِي فِي اِ۬لۡبَحۡرِ بِنِعۡمَتِ اِ۬للَّهِ لِيُرِيَكُم مِّنۡ ءَايَٰتِهِۦۚ إِنَّ فِي ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبّ۪ارٖ شَكُورٖ

32
00:08:33,983 --> 00:08:58,666
وَإِذَا غَشِيَهُم مَّوۡجٞ كَاَلظُّلَلِ دَعَوُاْ اُ۬للَّهَ مُخۡلِصِينَ لَهُ اُ۬لدِّينَ فَلَمَّا نَجَّىٰهُمۡ إِلَى اَ۬لۡبَرِّ فَمِنۡهُم مُّقۡتَصِدٞۚ وَمَا يَجۡحَدُ بِـَٔايَٰتِنَا إِلَّا كُلُّ خَتّ۪ارٖ كَفُورٖ

33
00:08:58,983 --> 00:09:31,616
۞يَٰأَيُّهَا اَ۬لنَّاسُ اُ۪تَّقُواْ رَبَّكُمۡ وَاَخۡشَوۡاْ يَوۡمٗا لَّا يَجۡزِي وَالِدٌ عَن وَلَدِهِۦ وَلَا مَوۡلُودٌ هُوَ جَازٍ عَن وَالِدِهِۦ شَيۡـًٔاۚ إِنَّ وَعۡدَ اَ۬للَّهِ حَقّٞۖ فَلَا تَغُرَّنَّكُمُ اُ۬لۡحَيَوٰةُ اُ۬لدُّنۡيۭا وَلَا يَغُرَّنَّكُم بِاللَّهِ اِ۬لۡغَرُورُ

34
00:09:31,983 --> 00:10:01,200
إِنَّ اَ۬للَّهَ عِندَهُۥ عِلۡمُ اُ۬لسَّاعَةِ وَيُنزِلُ اُ۬لۡغَيۡثَ وَيَعۡلَم مَّا فِي اِ۬لۡأَرۡحَامِۖ وَمَا تَدۡرِي نَفۡسٞ مَّاذَا تَكۡسِبُ غَدٗاۖ وَمَا تَدۡرِي نَفۡسُۢ بِأَيِّ أَرۡضٖ تَمُوتُۚ إِنَّ اَ۬للَّهَ عَلِيمٌ خَبِيرُۢ

