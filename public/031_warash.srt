1
00:00:06,166 --> 00:00:14,649
أَلَٓمِّٓۖ

2
00:00:15,516 --> 00:00:22,483
تِلْكَ ءَايَٰتُ اُ۬لْكِتَٰبِ اِ۬لْحَكِيمِ

3
00:00:23,150 --> 00:00:28,900
هُديٗ وَرَحْمَةٗ لِّلْمُحْسِنِينَ

4
00:00:29,583 --> 00:00:42,866
اَ۬لذِينَ يُقِيمُونَ اَ۬لصَّلَوٰةَ وَيُوتُونَ اَ۬لزَّكَوٰةَ وَهُم بِالَاخِرَةِ هُمْ يُوقِنُونَۖ

5
00:00:43,500 --> 00:00:56,866
أُوْلَٰٓئِكَ عَلَيٰ هُديٗ مِّن رَّبِّهِمْۖ وَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ

6
00:00:57,883 --> 00:01:22,000
وَمِنَ اَ۬لنَّاسِ مَنْ يَّشْتَرِے لَهْوَ اَ۬لْحَدِيثِ لِيُضِلَّ عَن سَبِيلِ اِ۬للَّهِ بِغَيْرِ عِلْمٖ وَيَتَّخِذُهَا هُزُؤاًۖ ا۟وْلَٰٓئِكَ لَهُمْ عَذَابٞ مُّهِينٞۖ

7
00:01:22,766 --> 00:01:44,766
وَإِذَا تُتْل۪يٰ عَلَيْهِ ءَايَٰتُنَا وَلّ۪يٰ مُسْتَكْبِراٗ كَأَن لَّمْ يَسْمَعْهَا كَأَنَّ فِےٓ أُذْنَيْهِ وَقْراٗۖ فَبَشِّرْهُ بِعَذَابٍ اَلِيمٍۖ

8
00:01:46,750 --> 00:01:59,700
اِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتُ اُ۬لنَّعِيمِ

9
00:02:00,350 --> 00:02:11,100
خَٰلِدِينَ فِيهَاۖ وَعْدَ اَ۬للَّهِ حَقّاٗۖ وَهُوَ اَ۬لْعَزِيزُ اُ۬لْحَكِيمُۖ

10
00:02:11,666 --> 00:02:49,216
۞خَلَقَ اَ۬لسَّمَٰوَٰتِ بِغَيْرِ عَمَدٖ تَرَوْنَهَاۖ وَأَلْق۪يٰ فِے اِ۬لَارْضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمْ وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖۖ وَأَنزَلْنَا مِنَ اَ۬لسَّمَآءِ مَآءٗ فَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٖ كَرِيمٍۖ

11
00:02:50,216 --> 00:03:09,383
هَٰذَا خَلْقُ اُ۬للَّهِ فَأَرُونِے مَاذَا خَلَقَ اَ۬لذِينَ مِن دُونِهِۦۖ بَلِ اِ۬لظَّٰلِمُونَ فِے ضَلَٰلٖ مُّبِينٖۖ

12
00:03:10,116 --> 00:03:35,450
وَلَقَدَ اٰتَيْنَا لُقْمَٰنَ اَ۬لْحِكْمَةَ أَنُ اُ۟شْكُرْ لِلهِۖ وَمَنْ يَّشْكُرْ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦۖ وَمَن كَفَرَ فَإِنَّ اَ۬للَّهَ غَنِيٌّ حَمِيدٞۖ

13
00:03:36,776 --> 00:03:53,183
وَإِذْ قَالَ لُقْمَٰنُ لِابْنِهِۦ وَهُوَ يَعِظُهُۥ يَٰبُنَيِّ لَا تُشْرِكْ بِاللَّهِۖ إِنَّ اَ۬لشِّرْكَ لَظُلْمٌ عَظِيمٞۖ

14
00:03:53,976 --> 00:04:16,883
وَوَصَّيْنَا اَ۬لِانسَٰنَ بِوَٰلِدَيْهِۖ حَمَلَتْهُ أُمُّهُۥ وَهْناً عَلَيٰ وَهْنٖ وَفِصَٰلُهُۥ فِے عَامَيْنِۖ أَنُ اُ۟شْكُرْ لِے وَلِوَٰلِدَيْكَۖ إِلَيَّ اَ۬لْمَصِيرُۖ

15
00:04:17,636 --> 00:04:53,266
وَإِن جَٰهَدَٰكَ عَلَيٰٓ أَن تُشْرِكَ بِے مَا لَيْسَ لَكَ بِهِۦ عِلْمٞ فَلَا تُطِعْهُمَاۖ وَصَاحِبْهُمَا فِے اِ۬لدُّنْي۪ا مَعْرُوفاٗۖ وَاتَّبِعْ سَبِيلَ مَنَ اَنَابَ إِلَيَّۖ ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَۖ

16
00:04:54,816 --> 00:05:21,633
يَٰبُنَيِّ إِنَّهَآ إِن تَكُ مِثْقَالُ حَبَّةٖ مِّنْ خَرْدَلٖ فَتَكُن فِے صَخْرَةٍ اَوْ فِے اِ۬لسَّمَٰوَٰتِ أَوْ فِے اِ۬لَارْضِ يَاتِ بِهَا اَ۬للَّهُۖ إِنَّ اَ۬للَّهَ لَطِيفٌ خَبِيرٞۖ

17
00:05:22,356 --> 00:05:41,183
يَٰبُنَيِّ أَقِمِ اِ۬لصَّلَوٰةَ وَامُرْ بِالْمَعْرُوفِ وَانْهَ عَنِ اِ۬لْمُنكَرِ وَاصْبِرْ عَلَيٰ مَآ أَصَابَكَۖ إِنَّ ذَٰلِكَ مِنْ عَزْمِ اِ۬لُامُورِۖ

18
00:05:42,496 --> 00:05:59,433
وَلَا تُصَٰعِرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِے اِ۬لَارْضِ مَرَحاًۖ اِنَّ اَ۬للَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٖ فَخُورٖۖ

19
00:05:59,956 --> 00:06:13,633
وَاقْصِدْ فِے مَشْيِكَ وَاغْضُضْ مِن صَوْتِكَۖ إِنَّ أَنكَرَ اَ۬لَاصْوَٰتِ لَصَوْتُ اُ۬لْحَمِيرِۖ

20
00:06:15,076 --> 00:06:46,550
أَلَمْ تَرَوَاْ اَنَّ اَ۬للَّهَ سَخَّرَ لَكُم مَّا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِ وَأَسْبَغَ عَلَيْكُمْ نِعَمَهُۥ ظَٰهِرَةٗ وَبَاطِنَةٗۖ وَمِنَ اَ۬لنَّاسِ مَنْ يُّجَٰدِلُ فِے اِ۬للَّهِ بِغَيْرِ عِلْمٖ وَلَا هُديٗ وَلَا كِتَٰبٖ مُّنِيرٖۖ

21
00:06:48,136 --> 00:07:15,900
وَإِذَا قِيلَ لَهُمُ اُ۪تَّبِعُواْ مَآ أَنزَلَ اَ۬للَّهُ قَالُواْ بَلْ نَتَّبِعُ مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآۖ أَوَلَوْ كَانَ اَ۬لشَّيْطَٰنُ يَدْعُوهُمُۥٓ إِلَيٰ عَذَابِ اِ۬لسَّعِيرِۖ

22
00:07:16,516 --> 00:07:35,433
۞وَمَنْ يُّسْلِمْ وَجْهَهُۥٓ إِلَي اَ۬للَّهِ وَهُوَ مُحْسِنٞ فَقَدِ اِ۪سْتَمْسَكَ بِالْعُرْوَةِ اِ۬لْوُثْق۪يٰۖ وَإِلَي اَ۬للَّهِ عَٰقِبَةُ اُ۬لُامُورِۖ

23
00:07:36,116 --> 00:07:58,133
وَمَن كَفَرَ فَلَا يُحْزِنكَ كُفْرُهُۥٓۖ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُم بِمَا عَمِلُوٓاْۖ إِنَّ اَ۬للَّهَ عَلِيمُۢ بِذَاتِ اِ۬صُّدُورِۖ

24
00:07:59,036 --> 00:08:11,133
نُمَتِّعُهُمْ قَلِيلاٗ ثُمَّ نَضْطَرُّهُمُۥٓ إِلَيٰ عَذَابٍ غَلِيظٖۖ

25
00:08:11,796 --> 00:08:33,750
وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ لَيَقُولُنَّ اَ۬للَّهُۖ قُلِ اِ۬لْحَمْدُ لِلهِۖ بَلَ اَكْثَرُهُمْ لَا يَعْلَمُونَۖ

26
00:08:34,276 --> 00:08:45,450
لِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ إِنَّ اَ۬للَّهَ هُوَ اَ۬لْغَنِيُّ اُ۬لْحَمِيدُۖ

27
00:08:46,856 --> 00:09:12,000
وَلَوَ اَنَّمَا فِے اِ۬لَارْضِ مِن شَجَرَةٍ اَقْلَٰمٞ وَالْبَحْرُ يَمُدُّهُۥ مِنۢ بَعْدِهِۦ سَبْعَةُ أَبْحُرٖ مَّا نَفِدَتْ كَلِمَٰتُ اُ۬للَّهِۖ إِنَّ اَ۬للَّهَ عَزِيزٌ حَكِيمٞۖ

28
00:09:12,756 --> 00:09:29,150
مَّا خَلْقُكُمْ وَلَا بَعْثُكُمُۥٓ إِلَّا كَنَفْسٖ وَٰحِدَةٍۖ اِنَّ اَ۬للَّهَ سَمِيعُۢ بَصِيرٌۖ

29
00:09:30,516 --> 00:10:05,366
اَلَمْ تَرَ أَنَّ اَ۬للَّهَ يُولِجُ اُ۬ليْلَ فِے اِ۬لنَّه۪ارِ وَيُولِجُ اُ۬لنَّهَارَ فِے اِ۬ليْلِ وَسَخَّرَ اَ۬لشَّمْسَ وَالْقَمَرَ كُلّٞ يَجْرِےٓ إِلَيٰٓ أَجَلٖ مُّسَمّيٗ وَأَنَّ اَ۬للَّهَ بِمَا تَعْمَلُونَ خَبِيرٞۖ

30
00:10:06,916 --> 00:10:24,166
ذَٰلِكَ بِأَنَّ اَ۬للَّهَ هُوَ اَ۬لْحَقُّ وَأَنَّ مَا تَدْعُونَ مِن دُونِهِ اِ۬لْبَٰطِلُ وَأَنَّ اَ۬للَّهَ هُوَ اَ۬لْعَلِيُّ اُ۬لْكَبِيرُۖ

31
00:10:25,636 --> 00:10:49,833
أَلَمْ تَرَ أَنَّ اَ۬لْفُلْكَ تَجْرِے فِے اِ۬لْبَحْرِ بِنِعْمَتِ اِ۬للَّهِ لِيُرِيَكُم مِّنَ اٰيَٰتِهِۦٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَٰتٖ لِّكُلِّ صَبّ۪ارٖ شَكُورٖۖ

32
00:10:50,576 --> 00:11:24,216
وَإِذَا غَشِيَهُم مَّوْجٞ كَالظُّلَلِ دَعَوُاْ اُ۬للَّهَ مُخْلِصِينَ لَهُ اُ۬لدِّينَ فَلَمَّا نَجّ۪يٰهُمُۥٓ إِلَي اَ۬لْبَرِّ فَمِنْهُم مُّقْتَصِدٞۖ وَمَا يَجْحَدُ بِـَٔايَٰتِنَآ إِلَّا كُلُّ خَتّ۪ارٖ كَفُورٖۖ

33
00:11:25,976 --> 00:12:04,983
۞يَٰٓأَيُّهَا اَ۬لنَّاسُ اُ۪تَّقُواْ رَبَّكُمْ وَاخْشَوْاْ يَوْماٗ لَّا يَجْزِے وَالِدٌ عَنْ وَّلَدِهِۦ وَلَا مَوْلُودٌ هُوَ جَازٍ عَنْ وَّالِدِهِۦ شَيْـٔاٗۖ اِنَّ وَعْدَ اَ۬للَّهِ حَقّٞۖ فَلَا تَغُرَّنَّكُمُ اُ۬لْحَيَوٰةُ اُ۬لدُّنْي۪ا وَلَا يَغُرَّنَّكُم بِاللَّهِ اِ۬لْغَرُورُۖ

34
00:12:06,456 --> 00:12:40,850
إِنَّ اَ۬للَّهَ عِندَهُۥ عِلْمُ اُ۬لسَّاعَةِۖ وَيُنَزِّلُ اُ۬لْغَيْثَۖ وَيَعْلَمُ مَا فِے اِ۬لَارْحَامِۖ وَمَا تَدْرِے نَفْسٞ مَّاذَا تَكْسِبُ غَداٗۖ وَمَا تَدْرِے نَفْسُۢ بِأَيِّ أَرْضٖ تَمُوتُۖ إِنَّ اَ۬للَّهَ عَلِيمٌ خَبِيرٌۖ

