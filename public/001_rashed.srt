1
00:00:04,933 --> 00:00:09,466
بِسۡمِ اِ۬للَّهِ اِ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ

2
00:00:09,816 --> 00:00:14,250
اِ۬لۡحَمۡدُ لِلَّهِ رَبِّ اِ۬لۡعَٰلَمِينَ

3
00:00:14,533 --> 00:00:18,233
اَ۬لرَّحۡمَٰنِ اِ۬لرَّحِيم

4
00:00:18,533 --> 00:00:22,316
مَّلِكِ يَوۡمِ اِ۬لدِّينِ

5
00:00:22,616 --> 00:00:27,450
إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ

6
00:00:27,933 --> 00:00:32,266
اُ۪هۡدِنَا اَ۬لصِّرَٰطَ اَ۬لۡمُسۡتَقِيمَ

7
00:00:32,650 --> 00:00:35,983
صِرَٰطَ اَ۬لَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ

8
00:00:36,000 --> 00:00:42,566
غَيۡرِ اِ۬لۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا اَ۬لضَّآلِّينَ

